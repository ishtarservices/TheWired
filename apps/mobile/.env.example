# Endpoint overrides (Expo inlines EXPO_PUBLIC_* at bundle time — the mobile
# analog of the client's VITE_* vars; see src/lib/env.ts).
#
# Defaults need NO env file:
#   dev (expo start)      → local stack on the Metro machine
#                           (gateway http://<metro-host>:9080/api, relay ws://<metro-host>:7777)
#   release builds        → https://api.thewired.app/api + wss://relay.thewired.app
#
# Set these only to point a dev bundle somewhere else (e.g. prod data while
# developing UI, or a staging stack):
#EXPO_PUBLIC_API_URL=https://api.thewired.app/api
#EXPO_PUBLIC_RELAY_URL=wss://relay.thewired.app

# Dev-only QA auto-login (compiled out of release builds): nsec or hex key.
#EXPO_PUBLIC_QA_NSEC=
