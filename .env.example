# Docker Compose environment variables
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# PostgreSQL
POSTGRES_USER=thewired
POSTGRES_PASSWORD=changeme
POSTGRES_DB=thewired
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6380

# Meilisearch
MEILI_MASTER_KEY=changeme
MEILI_PORT=7700
MEILI_ENV=development

# Relay
RELAY_PORT=7777
RELAY_NAME=The Wired Relay
RUST_LOG=info,thewired_relay=debug

# Backend
BACKEND_PORT=3002

# Gateway
GATEWAY_PORT=9080

# LiveKit (voice/video SFU)
LIVEKIT_PORT=7880
LIVEKIT_API_SECRET=secret

# Blossom blob storage
MAX_BLOB_SIZE=104857600

# Share pages + mobile universal links (forwarded to the backend by
# docker-compose.prod.yml). See services/backend/.env.example for details.
WEB_BASE_URL=https://thewired.app
APPLE_APP_IDS=53RG2QV7HT.app.soot.mobile
ANDROID_PACKAGE_NAME=app.soot.mobile
ANDROID_CERT_SHA256=
IOS_APP_URL=
ANDROID_APP_URL=
DESKTOP_APP_URL=

# Signs protected-music playback tokens (?tk= on blobs + HLS). REQUIRED in
# production — the backend refuses to mint with it empty. openssl rand -hex 32
MEDIA_TOKEN_SECRET=
