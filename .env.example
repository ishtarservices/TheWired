# Docker Compose environment variables
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# Two consumers read this file:
#   - docker-compose.yml       (local dev: infra only, most values optional)
#   - docker-compose.prod.yml  (the server: every REQUIRED value must be set —
#                               compose refuses to start otherwise)
# Compose forwards ONLY the variables each service names in its
# `environment:` block; see docs/DEPLOY.md.

# ── PostgreSQL ────────────────────────────────────────────────────────────
POSTGRES_USER=thewired
POSTGRES_PASSWORD=changeme            # REQUIRED in prod: openssl rand -base64 32
POSTGRES_DB=thewired
POSTGRES_PORT=5432

# Host interface the dev compose binds every service port to. Default
# 127.0.0.1: Postgres, Redis, Meilisearch, relay, backend, gateway and LiveKit
# are not reachable from the LAN. 0.0.0.0 only when another device must reach
# them (e.g. a phone testing against the SFU). Caddy's 80/443 are always public.
BIND_ADDR=127.0.0.1

# ── Redis ─────────────────────────────────────────────────────────────────
REDIS_PORT=6380
# Optional in dev, recommended: with it set, Redis starts with --requirepass and
# the in-compose REDIS_URLs carry it. The native backend/gateway (pnpm dev)
# must then use redis://:<password>@localhost:6380 (services/backend/.env,
# gateway env). Empty = no password (the port is loopback-only regardless).
REDIS_PASSWORD=

# ── Meilisearch ───────────────────────────────────────────────────────────
MEILI_MASTER_KEY=changeme             # REQUIRED in prod: openssl rand -base64 32
MEILI_PORT=7700
MEILI_ENV=development

# ── Relay ─────────────────────────────────────────────────────────────────
RELAY_PORT=7777
RELAY_NAME=The Wired Relay
RUST_LOG=info,thewired_relay=debug
RELAY_SECRET_KEY=                     # REQUIRED in prod: openssl rand -hex 32
# RELAY_URL=wss://relay.thewired.app  # public URL the relay advertises (prod default)
# The backend ingester's pubkey (hex of INGEST_SECRET_KEY below) — without it the
# relay serves the backend no kind-1059 wraps (no DM pushes) and no space-scoped
# chat (no space-mention pushes, no live space activity).
RELAY_INGEST_PUBKEYS=
# What an untargeted kind-1 REQ (a "give me everything" timeline) returns:
# all (default) = every note on the relay; community = only accounts that use
# The Wired (app accounts, space members, relay lists naming this relay).
# Targeted requests (ids, authors, #e/#p/#a/#d/#h, search) are never affected.
# RELAY_FIREHOSE_POLICY=community

# ── Backend ───────────────────────────────────────────────────────────────
BACKEND_PORT=3002
# ALLOWED_ORIGINS=https://thewired.app,tauri://localhost,http://localhost
# PUBLIC_URL=https://api.thewired.app
# Ingest-role key (64-hex or nsec): the backend AUTHs to the relay with it to read
# gift wraps (DM push) and reports. Its pubkey goes in RELAY_INGEST_PUBKEYS above.
INGEST_SECRET_KEY=                    # openssl rand -hex 32
ADMIN_PUBKEYS=                        # comma-separated hex pubkeys (report review + new-report push)
REPORT_WEBHOOK_URL=                   # Discord/Slack webhook for new reports (optional)
VAPID_PUBLIC_KEY=                     # web push (optional)
VAPID_PRIVATE_KEY=
GIF_API_KEY=                          # Klipy (optional)

# Blob storage / transcoding
MAX_BLOB_SIZE=524288000               # bytes; prod default 500 MB
TRANSCODE_ENQUEUE=true
TRANSCODE_WORKER=true
TRANSCODE_CONCURRENCY=1

# Signs protected-music playback tokens and members-only media grants (?tk= on
# blobs + HLS). REQUIRED in production — the backend refuses to mint with it
# empty. openssl rand -hex 32
MEDIA_TOKEN_SECRET=

# Members-only space media (docs/MEDIA_STORAGE.md): off | log | enforce
SPACE_MEDIA_GATE=log
# Hostnames a kind-24242 `server` tag may name (default: PUBLIC_URL's host,
# plus localhost/127.0.0.1 outside production)
BLOSSOM_SERVER_NAMES=
UPLOAD_RATE_PER_MIN=30                # Blossom uploads per pubkey per minute
UPLOAD_DAILY_BYTES=2147483648         # Blossom bytes per pubkey per UTC day

# Gateway-signed identity headers (gateway ↔ backend, same value on both).
# Empty = not sent; GATEWAY_AUTH_MODE off = trust the header as before,
# warn = verify + log, enforce = drop unverified identities. openssl rand -hex 32
GATEWAY_SHARED_SECRET=
GATEWAY_AUTH_MODE=off
# Fastify trustProxy (default: loopback + RFC1918 — covers the Docker bridges)
# TRUST_PROXY=

# ── Gateway ───────────────────────────────────────────────────────────────
GATEWAY_PORT=9080
# GATEWAY_ENV=production flips TRUSTED_PROXIES to empty (trust nobody's
# X-Forwarded-*) and CORS to deny-by-default; set TRUSTED_PROXIES to the proxy
# subnet there. Dev defaults: the private ranges and "*".
# GATEWAY_ENV=development
# TRUSTED_PROXIES=
NIP98_REQUIRE_PAYLOAD=off             # NIP-98 payload tag: off | warn | enforce
RATE_LIMIT_IP_PER_MIN=1200            # per-client-IP ceiling on every /api request (0 = off)

# ── LiveKit (voice/video SFU) ─────────────────────────────────────────────
LIVEKIT_PORT=7880
LIVEKIT_API_KEY=devkey                # REQUIRED in prod (any name, e.g. thewired)
LIVEKIT_API_SECRET=                   # REQUIRED (dev too): openssl rand -base64 32 — compose
                                      # refuses to start without it; whoever has it mints room tokens
# Public IP of the host, advertised in ICE candidates. REQUIRED in prod;
# 127.0.0.1 / a container IP means every remote client fails to connect.
LIVEKIT_NODE_IP=
# Hostname for the embedded TURN relay (A record → LIVEKIT_NODE_IP, DNS-only).
LIVEKIT_TURN_DOMAIN=turn.thewired.app

# ── Share pages + mobile universal links ──────────────────────────────────
# (thewired.app/music/*, /profile/*, /.well-known/*). Store URLs empty → the
# landing page's #download section. See services/backend/.env.example.
WEB_BASE_URL=https://thewired.app
APPLE_APP_IDS=53RG2QV7HT.app.soot.mobile
ANDROID_PACKAGE_NAME=app.soot.mobile
ANDROID_CERT_SHA256=                  # leave empty until the Android app has a release key;
                                      # then Play Console › App signing › SHA-256 (colon form)
IOS_APP_URL=
ANDROID_APP_URL=
DESKTOP_APP_URL=                      # e.g. the GitHub releases page
