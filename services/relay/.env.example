DATABASE_URL=postgres://thewired:thewired@localhost:5432/thewired
RELAY_PORT=7777
RELAY_NAME=The Wired Relay
RELAY_DESCRIPTION=Custom NIP-29 relay for The Wired
RUST_LOG=info,thewired_relay=debug
# The backend's ingest-role pubkey(s), comma-separated hex: the pubkey of the
# backend's INGEST_SECRET_KEY. Only this role may read every kind-1059 gift
# wrap (content-free DM pushes), every kind-1984 report, and every space-scoped
# (h-tagged) event without membership (space-mention pushes, live space
# activity). Empty = the backend sees none of them → no DM or space-mention
# pushes (the relay warns at startup).
RELAY_INGEST_PUBKEYS=
# Gift-wrap read gate: enforce (default) | warn | off (docs/DM_WIRE_CONTRACT.md §7.1).
RELAY_WRAP_AUTH_GATE=enforce
