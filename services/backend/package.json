{
  "name": "@thewired/backend",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file=.env src/db/migrate-cli.ts",
    "backfill:covers": "tsx --env-file=.env src/scripts/backfillCoverVariants.ts",
    "reports": "tsx --env-file=.env src/scripts/reports.ts",
    "reports:list": "tsx --env-file=.env src/scripts/reports.ts list",
    "reports:show": "tsx --env-file=.env src/scripts/reports.ts show",
    "reports:resolve": "tsx --env-file=.env src/scripts/reports.ts resolve",
    "reports:lift": "tsx --env-file=.env src/scripts/reports.ts lift",
    "reports:restore": "tsx --env-file=.env src/scripts/reports.ts restore",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/multipart": "^9.4.0",
    "@ishtarservices/shared-types": "workspace:*",
    "@livekit/protocol": "^1.45.0",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^1.8.0",
    "bullmq": "^5.34.0",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.7",
    "file-type": "^22.1.1",
    "ioredis": "^5.4.2",
    "livekit-server-sdk": "^2.15.0",
    "meilisearch": "^0.46.0",
    "nostr-tools": "^2.23.1",
    "pino": "^9.6.0",
    "postgres": "^3.4.5",
    "sharp": "^0.35.5",
    "web-push": "^3.6.7",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.12.0",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^4.1.4",
    "drizzle-kit": "^0.31.11",
    "ioredis-mock": "^8.13.1",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.4",
    "ws": "^8.21.0"
  }
}
