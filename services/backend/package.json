{
  "name": "@thewired/backend",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file=.env src/db/migrate-cli.ts",
    "backfill:covers": "tsx --env-file=.env src/scripts/backfillCoverVariants.ts",
    "reports": "tsx --env-file=.env src/scripts/reports.ts",
    "reports:list": "tsx --env-file=.env src/scripts/reports.ts list",
    "reports:show": "tsx --env-file=.env src/scripts/reports.ts show",
    "reports:resolve": "tsx --env-file=.env src/scripts/reports.ts resolve",
    "reports:lift": "tsx --env-file=.env src/scripts/reports.ts lift",
    "reports:restore": "tsx --env-file=.env src/scripts/reports.ts restore",
    "search:purge-nonpublic": "tsx --env-file=.env src/scripts/purgeNonPublicSearchDocs.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@fastify/cors": "^11.4.1",
    "@fastify/helmet": "^13.2.0",
    "@fastify/multipart": "^10.1.8",
    "@ishtarservices/shared-types": "workspace:*",
    "@livekit/protocol": "^1.53.4",
    "@noble/curves": "^1.9.7",
    "@noble/hashes": "^1.8.0",
    "bullmq": "^6.7.1",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.8",
    "file-type": "^22.3.0",
    "ioredis": "^5.11.1",
    "livekit-server-sdk": "^2.19.2",
    "meilisearch": "^0.62.0",
    "nostr-tools": "^2.25.5",
    "pino": "^9.6.0",
    "postgres": "^4.1.0",
    "sharp": "^0.35.5",
    "web-push": "^3.6.7",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.2",
    "@vitest/coverage-v8": "^5.1.0",
    "drizzle-kit": "^0.31.11",
    "ioredis-mock": "^8.13.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "ws": "^8.22.1"
  }
}
