DATABASE_URL=postgres://thewired:thewired@localhost:5432/thewired
REDIS_URL=redis://localhost:6380
MEILISEARCH_URL=http://localhost:7700
MEILISEARCH_KEY=thewired_dev_key
RELAY_URL=ws://localhost:7777
PORT=3002
LOG_LEVEL=debug
GIF_API_KEY=
GIF_CLIENT_KEY=thewired_v1
BLOB_DIR=blobs
MAX_BLOB_SIZE=104857600
SPACE_MEDIA_GATE=log
BLOSSOM_SERVER_NAMES=
UPLOAD_RATE_PER_MIN=30
UPLOAD_DAILY_BYTES=2147483648

# LiveKit SFU — needed for voice channels and DM call SFU fallback.
# Local dev: `livekit-server --dev` (listens on :7880, creds devkey/secret).
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# Cloudflare — provisions per-user *named* tunnels for self-hosted relays
# (Decentralized Spaces M7, POST /relays/tunnel/provision). Leave blank to
# disable named tunnels (clients fall back to zero-config quick tunnels).
# Token scope: Account › Cloudflare Tunnel:Edit + Zone › DNS:Edit on the tunnel
# zone. Backend-only — never sent to clients.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ZONE_ID=
# DNS zone for per-user relay subdomains (<id>.relay.thewired.app). Must be a
# hostname inside CLOUDFLARE_ZONE_ID.
TUNNEL_HOSTNAME_ZONE=relay.thewired.app

# Mobile app links (thewired.app/.well-known/, served by routes/wellKnown.ts).
# APPLE_APP_IDS: comma-separated TEAMID.bundleid entries for the AASA file.
# ANDROID_CERT_SHA256: comma-separated release-cert SHA-256 fingerprints
# (colon-hex, from `eas credentials` / Play Console). Empty = assetlinks.json
# serves an empty statement list and Android app links stay off.
APPLE_APP_IDS=53RG2QV7HT.app.soot.mobile
ANDROID_PACKAGE_NAME=app.soot.mobile
ANDROID_CERT_SHA256=

# Public web origin used in OG share pages' canonical URLs.
WEB_BASE_URL=https://thewired.app

# Share pages (thewired.app/music/*, /profile/*): where "get the app" points per
# platform. Empty → the landing page's download section.
IOS_APP_URL=
ANDROID_APP_URL=
DESKTOP_APP_URL=

# Signs protected-music playback tokens (?tk= on blobs + HLS). REQUIRED in
# production — the backend refuses to mint with it empty. openssl rand -hex 32
MEDIA_TOKEN_SECRET=

# Reports (App Store 1.2). ADMIN_PUBKEYS (comma-separated hex) review them via
# /admin/* or `pnpm reports:*` and get a push per new report; the webhook
# (Discord/Slack) is the written backup. Reports reach the backend over the
# relay only with an ingest key (INGEST_SECRET_KEY + the relay's
# RELAY_INGEST_PUBKEYS) or a relay run with RELAY_REPORT_READ_GATE=off (dev).
# The same key is what lets the ingester read kind-1059 gift wraps for the
# content-free "new message" push — with it unset, or its pubkey missing from
# the relay's RELAY_INGEST_PUBKEYS, there are no DM pushes at all.
INGEST_SECRET_KEY=                    # openssl rand -hex 32; pubkey → relay RELAY_INGEST_PUBKEYS
ADMIN_PUBKEYS=
REPORT_WEBHOOK_URL=
# Open reports one account may have at once (default 10, 0 = unlimited).
# REPORTS_MAX_OPEN_PER_REPORTER=10

# Gateway-signed identity headers. The gateway HMACs X-Auth-Pubkey / X-Client-Ip
# into X-Gateway-Auth with this secret (same value as the gateway's
# GATEWAY_SHARED_SECRET; openssl rand -hex 32). GATEWAY_AUTH_MODE: off = trust
# the headers as before (default), warn = verify + log mismatches once a
# minute, enforce = drop the identity unless the MAC verifies. Roll out
# off → warn → enforce, only after the gateway has the secret.
GATEWAY_SHARED_SECRET=
GATEWAY_AUTH_MODE=off

# Which upstream hops may set X-Forwarded-For (Fastify trustProxy), so
# request.ip is the client. Default: loopback + RFC1918 (Docker bridges, native
# dev). "true" trusts every hop, "false" none, or a comma list of IPs/CIDRs.
# TRUST_PROXY=
