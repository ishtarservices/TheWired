# ============================================================
# The Wired V1 — Production Environment Variables
# Copy to .env and fill in all values marked with <...>
# ============================================================

# === Secrets (generate with: openssl rand -base64 32) ===
POSTGRES_PASSWORD=<generate-strong-password>
MEILI_MASTER_KEY=<generate-strong-key>
LIVEKIT_API_SECRET=<generate-strong-secret>

# Relay signing key (generate with: openssl rand -hex 32)
RELAY_SECRET_KEY=<generate-hex-key>

# Signs ?tk= playback tokens for protected music (generate with: openssl rand -hex 32).
# Required: the backend refuses to mint with an empty value in production.
MEDIA_TOKEN_SECRET=<generate-hex-key>

# Members-only space media (docs/MEDIA_STORAGE.md): off | log | enforce.
# Start at log; switch to enforce once both client releases are out.
SPACE_MEDIA_GATE=log
# Per-pubkey Blossom upload limits (defaults: 30/min, 2 GiB/day)
UPLOAD_RATE_PER_MIN=30
UPLOAD_DAILY_BYTES=2147483648

# === Environment ===
NODE_ENV=production
RUST_ENV=production
MEILI_ENV=production

# === Domain & CORS ===
# Comma-separated origins allowed by CORS
ALLOWED_ORIGINS=https://thewired.app,tauri://localhost,http://localhost
PUBLIC_URL=https://api.thewired.app

# === Database ===
POSTGRES_USER=thewired
POSTGRES_DB=thewired

# === Ports ===
# docker-compose.prod.yml publishes NO host ports for Postgres, Redis, the
# relay, the backend or the gateway — only Caddy (80/443) and LiveKit's media
# ports. These variables are read by the DEV compose file alone and have no
# effect in production; nothing here needs commenting out or removing.
# POSTGRES_PORT=5432
# REDIS_PORT=6379
# RELAY_PORT=7777
# BACKEND_PORT=3002
# GATEWAY_PORT=9080

# === Relay ===
RELAY_NAME=The Wired Relay
RUST_LOG=info,thewired_relay=info
# The PUBLIC wss:// URL clients dial. The relay's strict NIP-42 relay-tag check
# compares against it and the backend puts it in AUTH tags and DM push payloads;
# leave it unset and every AUTH fails.
PUBLIC_RELAY_URL=wss://<relay-hostname>

# DM wire contract v1 (docs/DM_WIRE_CONTRACT.md §7).
# Ingest-role key the backend uses to AUTH for kind-1059 gift wraps
# (generate with: openssl rand -hex 32); RELAY_INGEST_PUBKEYS is its hex pubkey.
INGEST_SECRET_KEY=<generate-hex-key>
RELAY_INGEST_PUBKEYS=<hex-pubkey-of-INGEST_SECRET_KEY>
# kind-1059 AUTH gate: warn for the first release, then enforce. off = disabled.
RELAY_WRAP_AUTH_GATE=warn
# Gift-wrap retention in days; 0 = keep forever.
RELAY_WRAP_RETENTION_DAYS=0
# Untargeted timeline requests (a bare kinds:[1] REQ): all | community.
# community = app users plus accounts whose own kind 10002/10050 stored on
# this relay names it; targeted requests (ids, authors, #e/#p/#a, search)
# are never affected.
RELAY_FIREHOSE_POLICY=all
# Abuse caps; 0 disables either one.
RELAY_RATE_MAX_MSGS=300
RELAY_MAX_CONNS_PER_IP=32
# WebSocket keepalive: ping interval and the silence after which a socket is
# dropped (frees its per-IP slot when a backgrounded phone loses it). 0 disables.
RELAY_WS_PING_SECS=30
RELAY_WS_IDLE_TIMEOUT_SECS=90

# Kind-1984 report read gate (author + ingest role only). on = default.
RELAY_REPORT_READ_GATE=on

# === Admin / reports (App Store 1.2) ===
# Admins review reports (GET/POST /api/admin/*, pnpm reports:*) and get a push
# for every new report on each device they registered with the app.
ADMIN_PUBKEYS=<comma-separated-hex-pubkeys>
# Discord/Slack incoming webhook for every new report (backup + written record).
REPORT_WEBHOOK_URL=
# Optional HMAC key for guest reporters' IP hashes (defaults to MEDIA_TOKEN_SECRET).
REPORT_IP_SALT=
# Gateway caps on POST /api/reports, per hour.
RATE_LIMIT_REPORT_ANON_PER_HOUR=5
RATE_LIMIT_REPORT_PER_HOUR=30

# === Push Notifications (generate with: npx web-push generate-vapid-keys) ===
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@thewired.app
# Optional Expo push access token (mobile app notifications).
EXPO_ACCESS_TOKEN=

# === LiveKit ===
LIVEKIT_URL=ws://livekit:7880
# Voice/video E2EE token gate (docs/E2EE_CALLS.md §6), on by default: the token
# routes refuse clients that don't send supportsE2EE=true (409 E2EE_REQUIRED).
# Set to false only to bridge a rollout of a client that can't encrypt yet;
# a plaintext client in an encrypted room hears noise and is heard by nobody.
VOICE_REQUIRE_E2EE=true
# Token-signing key id shared by the backend and LiveKit — any name, no default.
LIVEKIT_API_KEY=<key-name>
# Set to the VPS public IP so WebRTC clients can reach the SFU
LIVEKIT_NODE_IP=<vps-public-ip>

# === Cloudflare named tunnels (Decentralized Spaces M7) ===
# Lets users expose their self-hosted relay at <id>.relay.thewired.app.
# Leave blank to disable (clients fall back to *.trycloudflare.com quick tunnels).
# Token scope: Account › Cloudflare Tunnel:Edit + Zone › DNS:Edit on the zone below.
# Backend-only — never exposed to clients.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ZONE_ID=
TUNNEL_HOSTNAME_ZONE=relay.thewired.app

# === Optional ===
GIF_API_KEY=
LOG_LEVEL=info

# === Gateway ↔ backend identity contract ===
# One secret, set on BOTH the gateway and the backend: the gateway HMACs the
# X-Auth-Pubkey / X-Client-Ip it forwards into X-Gateway-Auth.
# (generate with: openssl rand -hex 32)
GATEWAY_SHARED_SECRET=<generate-hex-key>
# What the backend does with that MAC: off = trust the headers as before,
# warn = verify and log mismatches once a minute, enforce = drop the identity
# unless the MAC verifies. Deploy the secret to both containers with `warn`
# first; switch to `enforce` once the backend log is quiet.
GATEWAY_AUTH_MODE=warn
# Fastify trustProxy for the backend: which hops may set X-Forwarded-For.
# Default (unset) = loopback + RFC1918, which covers the Docker bridges.
# TRUST_PROXY=

# === Gateway edge hardening ===
# Marks the gateway as production: TRUSTED_PROXIES defaults to empty (trust
# nobody's X-Forwarded-*) and CORS denies when ALLOWED_ORIGINS is empty.
GATEWAY_ENV=production
# Whose X-Forwarded-For the gateway believes. Set it to the proxy's Docker
# subnet (`docker network inspect thewired_frontend` → e.g. 172.18.0.0/16);
# with it empty every request is keyed by the proxy's address, so the
# anonymous and auth-fail buckets collapse into one.
TRUSTED_PROXIES=<caddy-docker-subnet>
# NIP-98 `payload` tag on body-bearing /api requests: off (verify-if-present)
# → warn (log omissions) → enforce (401 PAYLOAD_REQUIRED). Stay on off/warn
# until every shipped client sends the tag.
NIP98_REQUIRE_PAYLOAD=off
# Per-client-IP ceiling on every /api request per minute, on top of the
# per-pubkey buckets (0 disables).
RATE_LIMIT_IP_PER_MIN=1200
# Redis-down behaviour for the rate limiter AND the NIP-98 replay guard:
# open = let requests through, closed = 503 (writes only, for the replay guard).
RATE_LIMIT_FAIL_MODE=open
# JSON body cap on /api (bytes); upload routes are exempt.
MAX_API_BODY_BYTES=2097152
